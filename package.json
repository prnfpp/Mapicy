{
  "name": "mapicy",
  "private": true,
  "version": "0.1.0",
  "description": "Mappatura degli accessi e dei trattamenti per un'agenzia di comunicazione. Locale, senza server, con esportazioni per il DPO.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run dev -w @mapicy/desktop",
    "build": "npm run build -w @mapicy/desktop",
    "impacchetta": "npm run impacchetta -w @mapicy/desktop",
    "verifica:ui": "npm run verifica:ui -w @mapicy/desktop"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
